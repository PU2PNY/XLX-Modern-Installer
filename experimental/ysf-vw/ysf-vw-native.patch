+//
+// Native VW is an opaque YSF wire path, not AMBE+2. Admission/ownership
+// remains in OpenStream. No late entry or peer forwarding in this version.
+void CYsfProtocol::OnVwPacketIn(const CBuffer &buffer, const CIp &ip, const CYSFFICH &fich)
+{
+    const uint16 sid = IpToStreamId(ip);
+    if ( fich.getFI() == YSF_FI_TERMINATOR && g_Reflector.IsTotBlocked(sid, &ip, false) )
+    { g_Reflector.ReleaseTotBlock(sid, &ip); return; }
+    CPacketStream *stream = GetStream(sid, &ip);
+    if ( stream == NULL ) return;
+    stream->Lock();
+    const bool active = stream->IsOpen() && 
+                        stream->IsYsfVw();
+    stream->Unlock();
+    if ( !active ) return;
+    const bool last = fich.getFI() == YSF_FI_TERMINATOR;
+    if ( !last && fich.getFI() != YSF_FI_COMMUNICATIONS ) return;
+    CDvFramePacket *frame = last ? static_cast<CDvFramePacket *>(new CDvLastFramePacket())
+                                : new CDvFramePacket();
+    frame->SetStreamId(sid);
+    frame->SetYsfVwWire(buffer.data(), ip);
+    if ( last )
+    {
+        OnDvLastFramePacketIn(static_cast<CDvLastFramePacket *>(frame), &ip);
+
+    }
+    else OnDvFramePacketIn(frame, &ip);
+}
+
+
+bool CYsfProtocol::VwEnabledAtAdmission(void) const
+{
+    // Root-owned persistent key, read only at VW header admission.
+    // Existing PTTs finish when the key changes. No polling or restart.
+    FILE *f = ::fopen("/etc/xlx-modern/ysf-vw.conf", "r");
+    if ( f == NULL ) return m_VwEnabled;
+    char value[4] = {0,0,0,0};
+    const size_t n = ::fread(value, 1, sizeof(value), f);
+    ::fclose(f);
+    return (n == 1 && value[0] == '1') ||
+           (n == 2 && value[0] == '1' && value[1] == '\n');
+}
