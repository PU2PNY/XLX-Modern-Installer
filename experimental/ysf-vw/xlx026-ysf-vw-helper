#!/usr/bin/python3
"""Limited administrative control for native YSF VW; never restarts services."""
import json, os, sys, tempfile
from pathlib import Path
KEY=Path('/etc/xlx-modern/ysf-vw.conf')
BINARY=Path('/xlxd/xlxd')
def status():
    supported=BINARY.is_file() and b'YSF VW native-only' in BINARY.read_bytes()
    try: enabled=KEY.read_bytes() in (b'1',b'1\n')
    except FileNotFoundError: enabled=False
    return {'supported':supported,'enabled':enabled,'scope':'YSF native only','restart_required':False}
def main():
    args=sys.argv[1:]
    if args==['status']:
        print(json.dumps(status()));return 0
    if len(args)!=2 or args[0]!='set' or args[1] not in ('0','1'):
        print(json.dumps({'error':'invalid_action'}));return 64
    if os.geteuid()!=0:
        print(json.dumps({'error':'root_required'}));return 77
    if not status()['supported']:
        print(json.dumps({'error':'core_without_vw_support'}));return 69
    KEY.parent.mkdir(mode=0o755,parents=True,exist_ok=True)
    if KEY.parent.is_symlink() or KEY.is_symlink():
        raise RuntimeError('unsafe_config_path')
    fd,name=tempfile.mkstemp(prefix='.ysf-vw-',dir=KEY.parent)
    try:
        os.fchmod(fd,0o644)
        with os.fdopen(fd,'wb') as f:
            f.write((args[1]+'\n').encode());f.flush();os.fsync(f.fileno())
        os.replace(name,KEY)
    finally:
        if os.path.exists(name):os.unlink(name)
    print(json.dumps(status()));return 0
if __name__=='__main__':sys.exit(main())
