diff --git a/src/dstar/xc.c b/src/dstar/xc.c
index 10b487d..f36aab1 100644
--- a/src/dstar/xc.c
+++ b/src/dstar/xc.c
@@ -88,0 +89,7 @@
+
+/* Optional per-stream DMR -> D-STAR gain. Zero preserves upstream behavior. */
+void xombe_xc_set_dmr_to_dstar_gain(xombe_xc *x, float gain_log2)
+{
+    if (x && x->from == XOMBE_DMR)
+        x->u.f.output_gain_log2 = gain_log2;
+}
