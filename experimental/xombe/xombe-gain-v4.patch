diff --git a/src/dstar/xc.c b/src/dstar/xc.c
index 7dbb239..10b487d 100644
--- a/src/dstar/xc.c
+++ b/src/dstar/xc.c
@@ -79,3 +79,10 @@ void xombe_xc_decision_get(const xombe_xc *x, xombe_xc_decision *out)
         out->out = (enum xombe_xc_out)x->u.f.out;
     }
 }
+
+/* Optional per-stream D-STAR -> AMBE+2 gain. Zero is the upstream default. */
+void xombe_xc_set_dstar_to_dmr_gain(xombe_xc *x, float gain_log2)
+{
+    if (x && x->from == XOMBE_DSTAR)
+        x->u.r.output_gain_log2 = gain_log2;
+}
