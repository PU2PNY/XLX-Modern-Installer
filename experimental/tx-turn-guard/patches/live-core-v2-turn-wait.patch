+#[derive(Clone, Debug, Serialize, Deserialize, Default, PartialEq)]
+struct TurnWait { module: String, callsigns: Vec<String>, until_ms: i64, remaining_ms: i64 }
+
+fn read_turn_wait() -> Vec<TurnWait> {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) } != 0 { return Vec::new(); }
+    let now = ts.tv_sec as i64 * 1000 + ts.tv_nsec as i64 / 1_000_000;
+    let mut rows = Vec::new();
+    for module in b'A'..=b'Z' {
+        let letter = (module as char).to_string();
+        let path = format!("/run/xlx-tx-turn-state/module-{}.json", letter);
+        let meta = match fs::metadata(&path) { Ok(x) if x.is_file() && x.len() <= 2048 => x, _ => continue };
+        if meta.len() < 2 { continue; }
+        let data = match fs::read(&path) { Ok(x) if x.len() <= 2048 => x, _ => continue };
+        let value: Value = match serde_json::from_slice(&data) { Ok(x) => x, _ => continue };
+        if value["module"].as_str() != Some(letter.as_str()) { continue; }
+        let until = match value["until_ms"].as_i64() { Some(x) => x, _ => continue };
+        let remaining = until.saturating_sub(now);
+        if remaining <= 0 || remaining > 7000 { continue; }
+        let callsigns: Vec<String> = value["callsigns"].as_array().into_iter().flatten().take(2)
+            .filter_map(|x| x.as_str()).filter(|s| !s.is_empty() && s.len() <= 24 && s.bytes().all(|c| c.is_ascii_uppercase() || c.is_ascii_digit() || b"/:.-".contains(&c)))
+            .map(str::to_owned).collect();
+        if callsigns.len() != 2 { continue; }
+        rows.push(TurnWait { module: letter, callsigns, until_ms: until, remaining_ms: remaining });
+    }
+    rows
+}
+async fn turn_wait_task(state: AppState) {
+    let mut tick = tokio::time::interval(Duration::from_millis(100));
+    let mut last = String::new();
+    loop {
+        tick.tick().await;
+        let rows = read_turn_wait();
+        let signature = rows.iter().map(|x|format!("{}:{}", x.module, x.until_ms)).collect::<Vec<_>>().join("|");
+        { state.snapshot.write().await.tx_turn_wait = rows; }
+        if signature != last { last = signature; broadcast_state(&state).await; }
+    }
+}
+
 fn tx_state() -> String { "transmitting".to_string() }
 
