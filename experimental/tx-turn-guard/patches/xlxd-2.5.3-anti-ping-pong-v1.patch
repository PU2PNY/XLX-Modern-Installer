+////////////////////////////////////////////////////////////////////////////////////////
+// TX turn guard (anti ping-pong)
+
+std::string CReflector::TxTurnGuardIdentity(const CCallsign &callsign)
+{
+    char value[CALLSIGN_LEN + 1];
+    ::memset(value, 0, sizeof(value));
+    callsign.GetCallsignString(value);
+    if (value[0] != 0)
+        return std::string(value);
+    if (callsign.GetDmrid() != 0)
+        return std::string("DMR:") + std::to_string(callsign.GetDmrid());
+    return std::string();
+}
+
+long CReflector::TxTurnGuardEnvMs(const char *name, long fallback, long minValue, long maxValue)
+{
+    const char *raw = ::getenv(name);
+    if ((raw == NULL) || (*raw == 0))
+        return fallback;
+    errno = 0;
+    char *end = NULL;
+    long value = ::strtol(raw, &end, 10);
+    if ((errno != 0) || (end == raw) || (*end != 0) || (value < minValue) || (value > maxValue))
+        return fallback;
+    return value;
+}
+
+
+void CReflector::TxTurnGuardPublish(char module, const STxTurnGuardState &state)
+{
+    const char *dir = ::getenv("XLX_TX_TURN_STATE_DIR");
+    if ((dir == NULL) || (*dir == 0)) return;
+    const std::string path = std::string(dir) + "/module-" + module + ".json";
+    const std::string temp = path + ".tmp";
+    auto safe = [](const std::string &raw) {
+        std::string result;
+        for (unsigned char c : raw)
+            if (((c >= 'A') && (c <= 'Z')) || ((c >= '0') && (c <= '9')) ||
+                (c == '/') || (c == ':') || (c == '.') || (c == '-'))
+                result += c;
+        return result.substr(0, 24);
+    };
+    std::ofstream out(temp, std::ios::out | std::ios::trunc);
+    if (!out.is_open()) return;
+    const long long until = state.pairActive
+        ? std::chrono::duration_cast<std::chrono::milliseconds>(state.cooldownUntil.time_since_epoch()).count()
+        : 0;
+    out << "{\"module\":\"" << module << "\",\"until_ms\":" << until
+        << ",\"callsigns\":[\"" << safe(state.pairA) << "\",\"" << safe(state.pairB) << "\"]}\n";
+    out.close();
+    if (out && (::chmod(temp.c_str(), 0644) == 0)) ::rename(temp.c_str(), path.c_str());
+}
+
+bool CReflector::TxTurnGuardAdmit(const CDvHeaderPacket *header)
+{
+    const char *enabled = ::getenv("XLX_TX_TURN_GUARD");
+    if ((enabled == NULL) || (::strcmp(enabled, "1") != 0))
+        return true;
+
+    const int moduleIndex = GetModuleIndex(header->GetRpt2Module());
+    if (moduleIndex < 0)
+        return true;
+
+    const std::string user = TxTurnGuardIdentity(header->GetMyCallsign());
+    if (user.empty())
+        return true;
+
+    const long triggerMs = TxTurnGuardEnvMs("XLX_TX_TURN_TRIGGER_MS", 2000, 250, 10000);
+    const long cooldownMs = TxTurnGuardEnvMs("XLX_TX_TURN_COOLDOWN_MS", 7000, 1000, 30000);
+    const long resetConfiguredMs = TxTurnGuardEnvMs("XLX_TX_TURN_RESET_MS", 60000, 10000, 600000);
+    const long resetMs = std::max(resetConfiguredMs, cooldownMs);
+    const auto now = std::chrono::steady_clock::now();
+
+    std::lock_guard<std::mutex> lock(m_TxTurnGuardMutex);
+    STxTurnGuardState &state = m_TxTurnGuard[moduleIndex];
+
+    if (state.haveLastClose)
+    {
+        const auto idleMs = std::chrono::duration_cast<std::chrono::milliseconds>(now - state.lastCloseAt).count();
+        if (idleMs > resetMs)
+        {
+            state.previousUser.clear();
+            state.lastUser.clear();
+            state.lastTransitionFast = false;
+            state.haveLastClose = false;
+            state.pairActive = false;
+            state.pairA.clear();
+            state.pairB.clear();
+        }
+    }
+
+    if (state.pairActive && (now >= state.pairExpiresAt))
+    {
+        state.pairActive = false;
+        state.pairA.clear();
+        state.pairB.clear();
+    }
+
+    if (state.pairActive)
+    {
+        const bool isPairMember = (user == state.pairA) || (user == state.pairB);
+        if (!isPairMember)
+        {
+            std::cout << "TXTURN event=third_party_break module=" << header->GetRpt2Module() << std::endl;
+            state.pairActive = false;
+            state.pairA.clear();
+            state.pairB.clear();
+            state.previousUser.clear();
+            state.lastUser.clear();
+            state.lastTransitionFast = false;
+            TxTurnGuardPublish(header->GetRpt2Module(), state);
+        }
+        else if (now < state.cooldownUntil)
+        {
+            const auto remainingMs = std::chrono::duration_cast<std::chrono::milliseconds>(state.cooldownUntil - now).count();
+            std::cout << "TXTURN event=blocked module=" << header->GetRpt2Module()
+                      << " remaining_ms=" << remainingMs << std::endl;
+            return false;
+        }
+    }
+
+    bool currentTransitionFast = false;
+    if (state.haveLastClose)
+    {
+        const auto gapMs = std::chrono::duration_cast<std::chrono::milliseconds>(now - state.lastCloseAt).count();
+        currentTransitionFast = (gapMs >= 0) && (gapMs <= triggerMs);
+    }
+
+    if (!state.pairActive && currentTransitionFast && state.lastTransitionFast &&
+        !state.previousUser.empty() && !state.lastUser.empty() &&
+        (state.previousUser == user) && (state.lastUser != user))
+    {
+        state.pairActive = true;
+        state.pairA = user;
+        state.pairB = state.lastUser;
+        state.cooldownUntil = now;
+        state.pairExpiresAt = now + std::chrono::milliseconds(resetMs);
+        std::cout << "TXTURN event=pair_detected module=" << header->GetRpt2Module()
+                  << " trigger_ms=" << triggerMs << " cooldown_ms=" << cooldownMs << std::endl;
+    }
+
+    state.previousUser = state.lastUser;
+    state.lastUser = user;
+    state.lastTransitionFast = currentTransitionFast;
+    return true;
+}
+
+void CReflector::TxTurnGuardClosed(CPacketStream *stream)
+{
+    const char *enabled = ::getenv("XLX_TX_TURN_GUARD");
+    if ((enabled == NULL) || (::strcmp(enabled, "1") != 0) || (stream == NULL))
+        return;
+
+    const char module = GetStreamModule(stream);
+    const int moduleIndex = GetModuleIndex(module);
+    if (moduleIndex < 0)
+        return;
+
+    const std::string user = TxTurnGuardIdentity(stream->GetUserCallsign());
+    if (user.empty())
+        return;
+
+    const long cooldownMs = TxTurnGuardEnvMs("XLX_TX_TURN_COOLDOWN_MS", 7000, 1000, 30000);
+    const long resetConfiguredMs = TxTurnGuardEnvMs("XLX_TX_TURN_RESET_MS", 60000, 10000, 600000);
+    const long resetMs = std::max(resetConfiguredMs, cooldownMs);
+    const auto now = std::chrono::steady_clock::now();
+
+    std::lock_guard<std::mutex> lock(m_TxTurnGuardMutex);
+    STxTurnGuardState &state = m_TxTurnGuard[moduleIndex];
+    state.lastCloseAt = now;
+    state.haveLastClose = true;
+    if (state.pairActive && ((user == state.pairA) || (user == state.pairB)))
+    {
+        state.cooldownUntil = now + std::chrono::milliseconds(cooldownMs);
+        state.pairExpiresAt = now + std::chrono::milliseconds(resetMs);
+        TxTurnGuardPublish(module, state);
+        std::cout << "TXTURN event=cooldown_started module=" << module
+                  << " cooldown_ms=" << cooldownMs << std::endl;
+    }
+}
