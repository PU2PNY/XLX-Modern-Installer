[Unit]
Description=XLX026 GitHub Maintenance Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=xlxagent
Group=xlxagent
ExecStart=/usr/local/libexec/xlx026-github-agent/xlx026-github-agent.sh
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/xlx026-github-agent /root/backups-xlx026 /root/xlx026-lab
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
