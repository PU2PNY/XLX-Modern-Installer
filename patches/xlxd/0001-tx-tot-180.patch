+void CReflector::BlockTotStream(uint16 streamId, const CIp *ip)
+{
+    if ( (streamId == 0) || (ip == NULL) ) return;
+
+    std::lock_guard<std::mutex> guard(m_TotBlocksMutex);
+    for ( auto &item : m_TotBlocks )
+    {
+        if ( (item.m_StreamId == streamId) && (item.m_Ip == *ip) )
+        {
+            item.m_LastActivity.Now();
+            return;
+        }
+    }
+    m_TotBlocks.push_back(CTotBlock(streamId, *ip));
+}
+
+bool CReflector::IsTotBlocked(uint16 streamId, const CIp *ip, bool touch)
+{
+    if ( (streamId == 0) || (ip == NULL) ) return false;
+
+    std::lock_guard<std::mutex> guard(m_TotBlocksMutex);
+    for ( auto it = m_TotBlocks.begin(); it != m_TotBlocks.end(); )
+    {
+        if ( it->m_LastActivity.DurationSinceNow() > STREAM_TIMEOUT )
+        {
+            it = m_TotBlocks.erase(it);
+            continue;
+        }
+        if ( (it->m_StreamId == streamId) && (it->m_Ip == *ip) )
+        {
+            if ( touch ) it->m_LastActivity.Now();
+            return true;
+        }
+        ++it;
+    }
+    return false;
+}
+
+void CReflector::ReleaseTotBlock(uint16 streamId, const CIp *ip)
+{
+    if ( (streamId == 0) || (ip == NULL) ) return;
+
+    std::lock_guard<std::mutex> guard(m_TotBlocksMutex);
+    for ( auto it = m_TotBlocks.begin(); it != m_TotBlocks.end(); )
+    {
+        if ( (it->m_StreamId == streamId) && (it->m_Ip == *ip) )
+            it = m_TotBlocks.erase(it);
+        else
+            ++it;
+    }
+}
+
 void CReflector::CloseStream(CPacketStream *stream)
 {
     //
