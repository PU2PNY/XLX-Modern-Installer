#!/usr/bin/env bash
set -Eeuo pipefail
export LANG=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin

CONF="/etc/xlx-modern-control/helper.conf"
RADIO_HELPER="/usr/local/sbin/xlx-modern-radioid-helper"
ACCESS_HELPER="/usr/local/sbin/xlx-modern-access-helper"
[[ -r "$CONF" ]] || { echo "ERRO: helper.conf ausente" >&2; exit 2; }
# shellcheck disable=SC1090
source "$CONF"

: "${EXPECTED_SHA:?}"
: "${EXPECTED_VERSION:?}"
: "${SERVICE:=xlxd.service}"
: "${BIN:=/xlxd/xlxd}"
: "${XML:=/var/log/xlxd.xml}"
: "${LOG:=/var/log/xlx.log}"
: "${BACKUPS:=/var/backups/xlx-reflector}"

version(){ sed -n 's:.*<Version>\([^<]*\)</Version>.*:\1:p' "$XML" 2>/dev/null | head -1; }
sha(){ sha256sum "$BIN" | awk '{print $1}'; }
processes(){ pgrep -x xlxd 2>/dev/null | wc -l | tr -d ' '; }

case "${1:-}" in
  status)
    [[ "$#" -eq 1 ]] || exit 64
    echo "service=$(systemctl is-active "$SERVICE" 2>/dev/null || true)"
    echo "version=$(version)"
    echo "sha=$(sha)"
    echo "pid=$(systemctl show -p MainPID --value "$SERVICE" 2>/dev/null || true)"
    echo "processes=$(processes)"
    echo "active_since=$(systemctl show -p ActiveEnterTimestamp --value "$SERVICE" 2>/dev/null || true)"
    ;;
  listeners)
    [[ "$#" -eq 1 ]] || exit 64
    ss -H -lunp 2>/dev/null | awk '/xlxd/ {print $4}' | sort -u
    ;;
  logs)
    [[ "$#" -eq 1 ]] || exit 64
    [[ -r "$LOG" ]] && tail -n 80 "$LOG" || echo "Log indisponível"
    ;;
  backups)
    [[ "$#" -eq 1 ]] || exit 64
    if [[ -d "$BACKUPS" ]]; then
      find "$BACKUPS" -maxdepth 3 -mindepth 1 -type d -printf '%T@ %TY-%Tm-%Td %TH:%TM  %p\n' 2>/dev/null \
        | sort -nr | head -n 30 | cut -d' ' -f2-
    else
      echo "Diretório de backups indisponível"
    fi
    ;;
  restart)
    [[ "$#" -eq 1 ]] || exit 64
    before_sha="$(sha)"
    before_version="$(version)"
    [[ "$before_sha" == "$EXPECTED_SHA" ]] || { echo "ERRO: SHA atual divergente: $before_sha"; exit 20; }
    [[ "$before_version" == "$EXPECTED_VERSION" ]] || { echo "ERRO: versão atual divergente: $before_version"; exit 21; }
    systemctl is-active --quiet "$SERVICE" || { echo "ERRO: serviço não estava ativo antes do restart"; exit 22; }
    echo "restart_started=$(date -Is)"
    systemctl restart "$SERVICE"
    ok=0
    for _ in $(seq 1 30); do
      if systemctl is-active --quiet "$SERVICE" \
        && [[ "$(processes)" == "1" ]] \
        && [[ "$(version)" == "$EXPECTED_VERSION" ]] \
        && [[ "$(sha)" == "$EXPECTED_SHA" ]]; then
        ok=1
        break
      fi
      sleep 0.5
    done
    if [[ "$ok" != "1" ]]; then
      echo "ERRO: validação pós-restart falhou"
      echo "service=$(systemctl is-active "$SERVICE" 2>/dev/null || true)"
      echo "version=$(version)"
      echo "sha=$(sha)"
      echo "processes=$(processes)"
      exit 23
    fi
    echo "restart_finished=$(date -Is)"
    echo "service=active"
    echo "version=$EXPECTED_VERSION"
    echo "sha=$EXPECTED_SHA"
    echo "processes=1"
    ;;

  radioid-status)
    [[ "$#" -eq 1 ]] || exit 64
    [[ -x "$RADIO_HELPER" ]] || { echo 'ERRO: helper RadioID indisponível' >&2; exit 71; }
    exec "$RADIO_HELPER" status
    ;;
  radioid-check)
    [[ "$#" -eq 1 ]] || exit 64
    [[ -x "$RADIO_HELPER" ]] || { echo 'ERRO: helper RadioID indisponível' >&2; exit 71; }
    exec "$RADIO_HELPER" check
    ;;
  radioid-refresh)
    [[ "$#" -eq 1 ]] || exit 64
    [[ -x "$RADIO_HELPER" ]] || { echo 'ERRO: helper RadioID indisponível' >&2; exit 71; }
    exec "$RADIO_HELPER" refresh
    ;;
  radioid-search)
    [[ "$#" -eq 3 ]] || exit 64
    [[ -x "$RADIO_HELPER" ]] || { echo 'ERRO: helper RadioID indisponível' >&2; exit 71; }
    exec "$RADIO_HELPER" search "$2" "$3"
    ;;
  radioid-save)
    [[ "$#" -eq 10 ]] || exit 64
    [[ -x "$RADIO_HELPER" ]] || { echo 'ERRO: helper RadioID indisponível' >&2; exit 71; }
    exec "$RADIO_HELPER" save "${@:2}"
    ;;
  radioid-delete)
    [[ "$#" -eq 3 ]] || exit 64
    [[ -x "$RADIO_HELPER" ]] || { echo 'ERRO: helper RadioID indisponível' >&2; exit 71; }
    exec "$RADIO_HELPER" delete "$2" "$3"
    ;;

  access-status|interlink-status)
    [[ "$#" -eq 1 ]] || exit 64
    [[ -x "$ACCESS_HELPER" ]] || { echo 'ERRO: helper de acesso indisponível' >&2; exit 72; }
    exec "$ACCESS_HELPER" status
    ;;
  access-add-white|access-delete-white|access-add-black|access-delete-black)
    [[ "$#" -eq 2 ]] || exit 64
    [[ -x "$ACCESS_HELPER" ]] || { echo 'ERRO: helper de acesso indisponível' >&2; exit 72; }
    exec "$ACCESS_HELPER" "${1#access-}" "$2"
    ;;
  interlink-save)
    [[ "$#" -eq 4 ]] || exit 64
    [[ -x "$ACCESS_HELPER" ]] || { echo 'ERRO: helper de acesso indisponível' >&2; exit 72; }
    exec "$ACCESS_HELPER" save-interlink "$2" "$3" "$4"
    ;;
  interlink-delete)
    [[ "$#" -eq 2 ]] || exit 64
    [[ -x "$ACCESS_HELPER" ]] || { echo 'ERRO: helper de acesso indisponível' >&2; exit 72; }
    exec "$ACCESS_HELPER" delete-interlink "$2"
    ;;
  access-save-terminal)
    echo 'ERRO: configuração de terminal foi removida do Admin; use interlink-save' >&2
    exit 73
    ;;

  *)
    echo "Uso permitido: status|listeners|logs|backups|restart|radioid-*|access-*|interlink-*" >&2
    exit 64
    ;;
esac
