#!/usr/bin/env bash
set -Eeuo pipefail
export LANG=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077

CSV="${XLX_USERS_BASE_CSV:-/xlxd/users_db/users_base.csv}"
DB="${XLX_USERS_DB:-/xlxd/users_db/users.db}"
GEN="${XLX_USERS_GENERATOR:-/xlxd/users_db/create_user_db.php}"
REFRESH="${XLX_USERS_REFRESH:-/usr/local/sbin/xlx-modern-users-refresh}"
PATCH_DB="${XLX_RADIOID_PATCH_DB:-/var/lib/xlx-user-directory/radioid-local.db}"
BACKUPS="${XLX_RADIOID_BACKUPS:-/var/backups/xlx-reflector/radioid-control}"
LOCK="${XLX_RADIOID_LOCK:-/run/lock/xlx-modern-radioid-control.lock}"

fail(){ printf 'ERRO: %s\n' "$*" >&2; return 64; }
need(){
  [[ -f "$CSV" ]] || { fail 'base CSV não encontrada'; return 70; }
  [[ -f "$GEN" ]] || { fail 'gerador SQL não encontrado'; return 71; }
  for c in python3 sqlite3 php flock sha256sum; do command -v "$c" >/dev/null 2>&1 || { fail "$c não encontrado"; return 72; }; done
}
lock_radio(){
  install -d -m 0755 "$(dirname "$LOCK")"
  exec 9>"$LOCK"
  flock -n 9 || { fail 'outra operação de indicativos está em andamento'; return 75; }
}
text_ok(){ local v="$1" m="$2"; [[ ${#v} -le "$m" && "$v" != *$'\n'* && "$v" != *$'\r'* && "$v" != *','* ]]; }
init_patch_db(){
  install -d -m 0750 -o root -g www-data "$(dirname "$PATCH_DB")"
  sqlite3 "$PATCH_DB" >/dev/null <<'SQL'
PRAGMA journal_mode=DELETE;
CREATE TABLE IF NOT EXISTS local_records(
 callsign TEXT PRIMARY KEY,
 dmrid TEXT NOT NULL DEFAULT '',
 first_name TEXT NOT NULL DEFAULT '',
 last_name TEXT NOT NULL DEFAULT '',
 city TEXT NOT NULL DEFAULT '',
 state TEXT NOT NULL DEFAULT '',
 country TEXT NOT NULL DEFAULT '',
 updated_at INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS local_deletions(
 callsign TEXT PRIMARY KEY,
 dmrid TEXT NOT NULL DEFAULT '',
 updated_at INTEGER NOT NULL
);
SQL
  chown root:www-data "$PATCH_DB"
  chmod 0640 "$PATCH_DB"
}
sqlq(){ printf '%s' "$1" | sed "s/'/''/g"; }
backup(){
  local label="$1" stamp dir
  stamp="$(date -u +%Y%m%d_%H%M%S)"
  dir="$BACKUPS/${stamp}_${label}"
  install -d -m 0700 "$dir"
  cp -a "$CSV" "$dir/users_base.csv.before"
  if [[ -f "$DB" ]]; then cp -a "$DB" "$dir/users.db.before"; echo yes > "$dir/users.db.existed"; else echo no > "$dir/users.db.existed"; fi
  if [[ -f "$PATCH_DB" ]]; then cp -a "$PATCH_DB" "$dir/radioid-local.db.before"; echo yes > "$dir/patch.existed"; else echo no > "$dir/patch.existed"; fi
  sha256sum "$dir/users_base.csv.before" > "$dir/users_base.csv.before.sha256"
  [[ ! -f "$dir/users.db.before" ]] || sha256sum "$dir/users.db.before" > "$dir/users.db.before.sha256"
  printf '%s' "$dir"
}
restore(){
  local dir="$1"
  cp -a "$dir/users_base.csv.before" "$CSV"
  if [[ "$(cat "$dir/users.db.existed" 2>/dev/null || echo no)" == yes && -f "$dir/users.db.before" ]]; then cp -a "$dir/users.db.before" "$DB"; else rm -f "$DB"; fi
  if [[ "$(cat "$dir/patch.existed" 2>/dev/null || echo no)" == yes && -f "$dir/radioid-local.db.before" ]]; then
    install -m 0640 -o root -g www-data "$dir/radioid-local.db.before" "$PATCH_DB"
  else
    rm -f "$PATCH_DB"
  fi
}
atomic_rebuild(){
  local dir="$1" tmpdb="$DB.new.$$" rc integrity
  rm -f "$tmpdb" "$tmpdb-journal" "$tmpdb-wal" "$tmpdb-shm"
  set +e
  php "$GEN" "$CSV" "$tmpdb" > "$dir/rebuild.log" 2>&1
  rc=$?
  set -e
  if [[ "$rc" -ne 0 || ! -s "$tmpdb" ]]; then rm -f "$tmpdb"*; restore "$dir"; fail 'reconstrução SQL falhou; base anterior restaurada'; return 81; fi
  integrity="$(sqlite3 "$tmpdb" 'PRAGMA integrity_check;' 2>/dev/null || true)"
  if [[ "$integrity" != ok ]]; then rm -f "$tmpdb"*; restore "$dir"; fail 'novo banco SQL falhou na integridade; base anterior restaurada'; return 82; fi
  if ! sqlite3 "$tmpdb" "SELECT callsign,name,city_state FROM users LIMIT 1;" >/dev/null 2>&1; then rm -f "$tmpdb"*; restore "$dir"; fail 'estrutura do novo banco SQL é incompatível; base anterior restaurada'; return 83; fi
  if [[ -f "$DB" ]]; then chown --reference="$DB" "$tmpdb"; chmod --reference="$DB" "$tmpdb"; else chown root:www-data "$tmpdb"; chmod 0640 "$tmpdb"; fi
  mv -f "$tmpdb" "$DB"
  [[ "$(sqlite3 "$DB" 'PRAGMA integrity_check;' 2>/dev/null || true)" == ok ]] || { restore "$dir"; fail 'validação após publicação falhou; base anterior restaurada'; return 84; }
  sha256sum "$CSV" > "$dir/users_base.csv.after.sha256"
  sha256sum "$DB" > "$dir/users.db.after.sha256"
}
status(){
  need; init_patch_db
  python3 - "$CSV" "$DB" "$PATCH_DB" <<'PY'
import json,os,sqlite3,sys,time
csvp,dbp,patch=sys.argv[1:]
def meta(p):
    if not os.path.exists(p): return {'exists':False,'size':0,'mtime':0,'mtime_text':'—'}
    s=os.stat(p); return {'exists':True,'size':s.st_size,'mtime':int(s.st_mtime),'mtime_text':time.strftime('%d/%m/%Y %H:%M',time.localtime(s.st_mtime))}
with open(csvp,'rb') as f: records=max(0,sum(1 for _ in f)-1)
integ='ausente'
if os.path.exists(dbp):
    try:
        c=sqlite3.connect('file:'+dbp+'?mode=ro',uri=True,timeout=3); integ=c.execute('pragma integrity_check').fetchone()[0]; c.close()
    except Exception: integ='erro'
p=sqlite3.connect('file:'+patch+'?mode=ro',uri=True,timeout=3)
local_records=p.execute('select count(*) from local_records').fetchone()[0]
local_deletions=p.execute('select count(*) from local_deletions').fetchone()[0]
p.close()
print(json.dumps({'ok':True,'records':records,'csv':meta(csvp),'db':meta(dbp),'integrity':integ,'local_records':local_records,'local_deletions':local_deletions},ensure_ascii=False,separators=(',',':')))
PY
}
search(){
  need; init_patch_db
  local field="${1:-}" term="${2:-}"
  [[ "$field" =~ ^(callsign|dmrid|name|city|country)$ ]] || { fail 'filtro de pesquisa inválido'; return 85; }
  [[ -n "$term" ]] && text_ok "$term" 80 || { fail 'termo de pesquisa inválido'; return 86; }
  python3 - "$CSV" "$field" "$term" <<'PY'
import csv,fnmatch,json,sys
path,field,term=sys.argv[1:]; idx={'dmrid':0,'callsign':1,'city':4,'country':6}; pat=term.casefold(); rows=[]
def hit(v):
    v=v.casefold(); return fnmatch.fnmatch(v,pat) if '*' in pat or '?' in pat else pat in v
with open(path,'r',encoding='utf-8',errors='replace',newline='') as f:
    r=csv.reader(f); next(r,None)
    for row in r:
        if len(row)<7: continue
        value=(row[2]+' '+row[3]) if field=='name' else row[idx[field]]
        if hit(value):
            rows.append({'dmrid':row[0].strip(),'callsign':row[1].strip(),'first_name':row[2].strip(),'last_name':row[3].strip(),'city':row[4].strip(),'state':row[5].strip(),'country':row[6].strip()})
            if len(rows)>=50: break
print(json.dumps({'ok':True,'count':len(rows),'limited':len(rows)>=50,'rows':rows},ensure_ascii=False,separators=(',',':')))
PY
}
persist_save(){
  local od="$1" oc="${2^^}" dmr="$3" call="${4^^}" first="$5" last="$6" city="$7" state="$8" country="$9" now
  init_patch_db; now="$(date +%s)"
  sqlite3 "$PATCH_DB" "BEGIN IMMEDIATE;
DELETE FROM local_deletions WHERE callsign='$(sqlq "$call")';
INSERT INTO local_records(callsign,dmrid,first_name,last_name,city,state,country,updated_at)
VALUES('$(sqlq "$call")','$(sqlq "$dmr")','$(sqlq "$first")','$(sqlq "$last")','$(sqlq "$city")','$(sqlq "$state")','$(sqlq "$country")',$now)
ON CONFLICT(callsign) DO UPDATE SET dmrid=excluded.dmrid,first_name=excluded.first_name,last_name=excluded.last_name,city=excluded.city,state=excluded.state,country=excluded.country,updated_at=excluded.updated_at;
COMMIT;"
  if [[ -n "$oc" && "$oc" != "$call" ]]; then
    sqlite3 "$PATCH_DB" "BEGIN IMMEDIATE; DELETE FROM local_records WHERE callsign='$(sqlq "$oc")'; INSERT INTO local_deletions(callsign,dmrid,updated_at) VALUES('$(sqlq "$oc")','$(sqlq "$od")',$now) ON CONFLICT(callsign) DO UPDATE SET dmrid=excluded.dmrid,updated_at=excluded.updated_at; COMMIT;"
  fi
}
persist_delete(){
  local dmr="$1" call="${2^^}" now
  init_patch_db; now="$(date +%s)"
  sqlite3 "$PATCH_DB" "BEGIN IMMEDIATE; DELETE FROM local_records WHERE callsign='$(sqlq "$call")'; INSERT INTO local_deletions(callsign,dmrid,updated_at) VALUES('$(sqlq "$call")','$(sqlq "$dmr")',$now) ON CONFLICT(callsign) DO UPDATE SET dmrid=excluded.dmrid,updated_at=excluded.updated_at; COMMIT;"
}
save_record(){
  need; lock_radio; [[ "$#" -eq 9 ]] || { fail 'parâmetros inválidos'; return 87; }
  local od="$1" oc="${2^^}" dmr="$3" call="${4^^}" first="$5" last="$6" city="$7" state="$8" country="$9" dir rc action err
  [[ -z "$od" || "$od" =~ ^[0-9]{7}$ ]] || { fail 'Radio ID original inválido'; return 88; }
  [[ -z "$oc" || "$oc" =~ ^[A-Z0-9]{1,8}$ ]] || { fail 'indicativo original inválido'; return 89; }
  [[ -z "$dmr" || "$dmr" =~ ^[0-9]{7}$ ]] || { fail 'Radio ID deve ter 7 dígitos ou ficar vazio'; return 90; }
  [[ "$call" =~ ^[A-Z0-9]{1,8}$ ]] || { fail 'indicativo inválido'; return 91; }
  [[ -n "$first" && -n "$city" && -n "$state" && -n "$country" ]] || { fail 'nome, cidade, estado e país são obrigatórios'; return 92; }
  text_ok "$first" 80 && text_ok "$last" 80 && text_ok "$city" 80 && text_ok "$state" 80 && text_ok "$country" 80 || { fail 'campos não podem conter vírgulas ou quebras de linha'; return 93; }
  dir="$(backup save)"
  set +e
  action="$(python3 - "$CSV" "$od" "$oc" "$dmr" "$call" "$first" "$last" "$city" "$state" "$country" 2>"$dir/edit.error" <<'PY'
import csv,os,sys,tempfile
path,od,oc,dmr,call,first,last,city,state,country=sys.argv[1:]
with open(path,'r',encoding='utf-8',errors='strict',newline='') as f: rows=list(csv.reader(f))
if not rows: print('base CSV vazia',file=sys.stderr); raise SystemExit(10)
header,data=rows[0],rows[1:]; match=[]
if od or oc:
    for i,row in enumerate(data):
        if len(row)<7: continue
        if od and row[0].strip()!=od: continue
        if oc and row[1].strip().upper()!=oc: continue
        match.append(i)
    if len(match)!=1: print('cadastro original não foi localizado de forma única',file=sys.stderr); raise SystemExit(11)
    target=match[0]
else: target=None
for i,row in enumerate(data):
    if len(row)<7 or i==target: continue
    if dmr and row[0].strip()==dmr: print('Radio ID já pertence a outro cadastro',file=sys.stderr); raise SystemExit(12)
    if row[1].strip().upper()==call: print('indicativo já existe',file=sys.stderr); raise SystemExit(13)
new=[dmr,call,first,last,city,state,country]
if target is None: data.append(new); action='added'
else: data[target]=new; action='updated'
st=os.stat(path); fd,tmp=tempfile.mkstemp(prefix='.users_base.',dir=os.path.dirname(path),text=True); os.close(fd)
try:
    with open(tmp,'w',encoding='utf-8',newline='') as out:
        w=csv.writer(out,lineterminator='\n'); w.writerow(header); w.writerows(data)
    os.chmod(tmp,st.st_mode & 0o7777); os.chown(tmp,st.st_uid,st.st_gid); os.replace(tmp,path)
finally:
    if os.path.exists(tmp): os.unlink(tmp)
print(action)
PY
)"; rc=$?; set -e
  if [[ "$rc" -ne 0 ]]; then err="$(head -1 "$dir/edit.error" 2>/dev/null || true)"; restore "$dir"; fail "${err:-não foi possível salvar o cadastro}; base anterior restaurada"; return 94; fi
  persist_save "$od" "$oc" "$dmr" "$call" "$first" "$last" "$city" "$state" "$country" || { restore "$dir"; fail 'não foi possível persistir a alteração local'; return 95; }
  atomic_rebuild "$dir" || return $?
  python3 - "$action" "$dir" "$call" "$dmr" <<'PY'
import json,sys
print(json.dumps({'ok':True,'action':sys.argv[1],'backup':sys.argv[2],'callsign':sys.argv[3],'dmrid':sys.argv[4],'persistent':True},ensure_ascii=False,separators=(',',':')))
PY
}
delete_record(){
  need; lock_radio; [[ "$#" -eq 2 ]] || { fail 'parâmetros inválidos'; return 96; }
  local dmr="$1" call="${2^^}" dir rc err
  [[ -n "$dmr" || -n "$call" ]] || { fail 'identificação do cadastro ausente'; return 97; }
  [[ -z "$dmr" || "$dmr" =~ ^[0-9]{7}$ ]] || { fail 'Radio ID inválido'; return 98; }
  [[ -z "$call" || "$call" =~ ^[A-Z0-9]{1,8}$ ]] || { fail 'indicativo inválido'; return 99; }
  dir="$(backup delete)"
  set +e
  python3 - "$CSV" "$dmr" "$call" 2>"$dir/delete.error" <<'PY'
import csv,os,sys,tempfile
path,dmr,call=sys.argv[1:]
with open(path,'r',encoding='utf-8',errors='strict',newline='') as f: rows=list(csv.reader(f))
if not rows: raise SystemExit(2)
header,data=rows[0],rows[1:]; match=[]
for i,row in enumerate(data):
    if len(row)<7: continue
    if dmr and row[0].strip()!=dmr: continue
    if call and row[1].strip().upper()!=call: continue
    match.append(i)
if len(match)!=1: print('cadastro não foi localizado de forma única',file=sys.stderr); raise SystemExit(3)
del data[match[0]]
st=os.stat(path); fd,tmp=tempfile.mkstemp(prefix='.users_base.',dir=os.path.dirname(path),text=True); os.close(fd)
try:
    with open(tmp,'w',encoding='utf-8',newline='') as out:
        w=csv.writer(out,lineterminator='\n'); w.writerow(header); w.writerows(data)
    os.chmod(tmp,st.st_mode & 0o7777); os.chown(tmp,st.st_uid,st.st_gid); os.replace(tmp,path)
finally:
    if os.path.exists(tmp): os.unlink(tmp)
PY
  rc=$?; set -e
  if [[ "$rc" -ne 0 ]]; then err="$(head -1 "$dir/delete.error" 2>/dev/null || true)"; restore "$dir"; fail "${err:-não foi possível excluir}; nada foi alterado"; return 100; fi
  persist_delete "$dmr" "$call" || { restore "$dir"; fail 'não foi possível persistir a exclusão local'; return 101; }
  atomic_rebuild "$dir" || return $?
  python3 - "$dir" "$call" "$dmr" <<'PY'
import json,sys
print(json.dumps({'ok':True,'action':'deleted','backup':sys.argv[1],'callsign':sys.argv[2],'dmrid':sys.argv[3],'persistent':True},ensure_ascii=False,separators=(',',':')))
PY
}
refresh(){
  need; lock_radio
  [[ -x "$REFRESH" ]] || { fail 'atualizador de indicativos não encontrado'; return 102; }
  "$REFRESH" >/dev/null
  status
}
check(){
  need; init_patch_db
  python3 - "$DB" "$PATCH_DB" <<'PY'
import json,os,sqlite3,sys
out={'ok':True,'main':'ausente','local':'ausente'}
for key,p in [('main',sys.argv[1]),('local',sys.argv[2])]:
    if not os.path.exists(p): out['ok']=False; continue
    try:
        c=sqlite3.connect('file:'+p+'?mode=ro',uri=True,timeout=3); r=c.execute('pragma integrity_check').fetchone()[0]; c.close()
    except Exception: r='erro'
    out[key]=r
    if r!='ok': out['ok']=False
print(json.dumps(out,ensure_ascii=False,separators=(',',':')))
raise SystemExit(0 if out['ok'] else 2)
PY
}

case "${1:-}" in
  status) [[ "$#" -eq 1 ]] || exit 64; status ;;
  search) [[ "$#" -eq 3 ]] || exit 64; search "$2" "$3" ;;
  save) [[ "$#" -eq 10 ]] || exit 64; save_record "${@:2}" ;;
  delete) [[ "$#" -eq 3 ]] || exit 64; delete_record "$2" "$3" ;;
  refresh) [[ "$#" -eq 1 ]] || exit 64; refresh ;;
  check) [[ "$#" -eq 1 ]] || exit 64; check ;;
  *) printf 'Uso: %s status|search|save|delete|refresh|check\n' "$0" >&2; exit 64 ;;
esac
