#!/usr/bin/env bash
set -Eeuo pipefail
export LANG=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 027

STATE="${XLX_CONTROL_STATE:-/var/lib/xlx-modern-control}"
BACKROOT="${XLX_ACCESS_BACKUPS:-/var/backups/xlx-reflector/control-access}"
WL="${XLX_WHITELIST:-/xlxd/xlxd.whitelist}"
BL="${XLX_BLACKLIST:-/xlxd/xlxd.blacklist}"
IL="${XLX_INTERLINK:-/xlxd/xlxd.interlink}"
LOCK="${XLX_ACCESS_LOCK:-/run/lock/xlx-modern-control-access.lock}"

fail(){ printf 'ERRO: %s\n' "$*" >&2; exit 64; }
need(){
  for f in "$WL" "$BL" "$IL"; do [[ -f "$f" ]] || fail "arquivo ausente: $f"; done
  command -v flock >/dev/null 2>&1 || fail 'flock ausente'
  command -v python3 >/dev/null 2>&1 || fail 'python3 ausente'
}
lock_access(){
  install -d -m 0755 "$(dirname "$LOCK")"
  exec 9>"$LOCK"
  flock -n 9 || fail 'outra alteração de acesso está em andamento'
}
clean_rule(){
  local x="${1^^}"
  x="${x//[[:space:]]/}"
  [[ "$x" == '*' || "$x" =~ ^[A-Z0-9]{1,8}\*?$ ]] || return 1
  if [[ "$x" == *'*'* && "$x" != '*' ]]; then
    [[ "$x" =~ ^[A-Z0-9]{1,8}\*$ ]] || return 1
  fi
  printf '%s' "$x"
}
clean_peer(){
  local x="${1^^}"
  x="${x//[[:space:]]/}"
  [[ "$x" =~ ^[A-Z0-9]{1,8}$ ]] || return 1
  printf '%s' "$x"
}
clean_address(){
  local x="$1"
  [[ "$x" =~ ^[A-Za-z0-9._:-]{1,253}$ ]] || return 1
  printf '%s' "$x"
}
clean_modules(){
  local x="${1^^}"
  x="${x//[[:space:]]/}"
  [[ "$x" == '*' || "$x" =~ ^[A-Z]{1,26}$ ]] || return 1
  if [[ "$x" != '*' ]]; then
    x="$(printf '%s' "$x" | grep -o . | awk '!seen[$0]++' | tr -d '\n')"
  fi
  printf '%s' "$x"
}
read_rules(){ sed -E '/^[[:space:]]*($|#)/d;s/[[:space:]]//g' "$1"; }
status(){
  python3 - "$WL" "$BL" "$IL" <<'PY'
import json,re,sys
wl,bl,interlink=sys.argv[1:]
def rules(path):
    out=[]
    with open(path,'r',encoding='utf-8',errors='replace') as handle:
        for raw in handle:
            line=raw.strip()
            if not line or line.startswith('#'):
                continue
            out.append(re.sub(r'\s+','',line))
    return out
entries=[]
invalid=[]
with open(interlink,'r',encoding='utf-8',errors='replace') as handle:
    for number,raw in enumerate(handle,1):
        line=raw.strip()
        if not line or line.startswith('#'):
            continue
        parts=[p for p in re.split(r'[\s,]+',line) if p]
        if len(parts)<3:
            invalid.append({'line':number,'text':line})
            continue
        entries.append({'peer':parts[0].upper(),'address':parts[1],'modules':parts[2].upper()})
print(json.dumps({
    'ok':len(invalid)==0,
    'whitelist':rules(wl),
    'blacklist':rules(bl),
    'interlink':{'entries':entries,'count':len(entries),'invalid':invalid},
},ensure_ascii=False,separators=(',',':')))
PY
}
backup_files(){
  local stamp dir
  stamp="$(date -u +%Y%m%d_%H%M%S)"
  dir="$BACKROOT/$stamp"
  install -d -m 0700 "$dir"
  cp -a "$WL" "$BL" "$IL" "$dir/"
  sha256sum "$dir/$(basename "$WL")" "$dir/$(basename "$BL")" "$dir/$(basename "$IL")" > "$dir/SHA256_BEFORE.txt"
  printf '%s' "$dir"
}
write_rules(){
  local file="$1" rule="$2" op="$3" tmp
  tmp="$(mktemp "${file}.new.XXXXXX")"
  {
    grep -E '^[[:space:]]*#|^[[:space:]]*$' "$file" || true
    if [[ "$op" == add ]]; then
      read_rules "$file"
      printf '%s\n' "$rule"
    else
      while IFS= read -r x; do [[ "$x" != "$rule" ]] && printf '%s\n' "$x"; done < <(read_rules "$file")
    fi
  } | awk '!seen[$0]++' > "$tmp"
  chown --reference="$file" "$tmp" 2>/dev/null || chown www-data:www-data "$tmp"
  chmod --reference="$file" "$tmp" 2>/dev/null || chmod 0644 "$tmp"
  mv -f "$tmp" "$file"
}
write_interlink(){
  local peer="$1" address="$2" modules="$3" op="$4" tmp
  tmp="$(mktemp "${IL}.new.XXXXXX")"
  python3 - "$IL" "$tmp" "$peer" "$address" "$modules" "$op" <<'PY'
import re,sys
src,dst,peer,address,modules,op=sys.argv[1:]
peer=peer.upper()
with open(src,'r',encoding='utf-8',errors='strict') as handle:
    lines=handle.readlines()
matches=[]
for idx,raw in enumerate(lines):
    line=raw.strip()
    if not line or line.startswith('#'):
        continue
    parts=[p for p in re.split(r'[\s,]+',line) if p]
    if parts and parts[0].upper()==peer:
        matches.append(idx)
if len(matches)>1:
    raise SystemExit('peer duplicado no arquivo Interlink; corrija manualmente antes de usar o Admin')
if op=='delete':
    if not matches:
        raise SystemExit('peer Interlink não encontrado')
    del lines[matches[0]]
elif op=='save':
    newline=f'{peer} {address} {modules}\n'
    if matches:
        lines[matches[0]]=newline
    else:
        if lines and not lines[-1].endswith('\n'):
            lines[-1]+='\n'
        lines.append(newline)
else:
    raise SystemExit('operação Interlink inválida')
with open(dst,'w',encoding='utf-8',newline='') as handle:
    handle.writelines(lines)
PY
  chown --reference="$IL" "$tmp" 2>/dev/null || chown www-data:www-data "$tmp"
  chmod --reference="$IL" "$tmp" 2>/dev/null || chmod 0644 "$tmp"
  mv -f "$tmp" "$IL"
}
validate_interlink(){
  python3 - "$IL" <<'PY'
import re,sys
path=sys.argv[1]
seen=set()
with open(path,'r',encoding='utf-8',errors='strict') as handle:
    for number,raw in enumerate(handle,1):
        line=raw.strip()
        if not line or line.startswith('#'):
            continue
        parts=[p for p in re.split(r'[\s,]+',line) if p]
        if len(parts)<3:
            raise SystemExit(f'linha Interlink inválida: {number}')
        peer,address,modules=parts[:3]
        peer=peer.upper(); modules=modules.upper()
        if not re.fullmatch(r'[A-Z0-9]{1,8}',peer):
            raise SystemExit(f'peer Interlink inválido: {peer}')
        if peer in seen:
            raise SystemExit(f'peer Interlink duplicado: {peer}')
        seen.add(peer)
        if not re.fullmatch(r'[A-Za-z0-9._:-]{1,253}',address):
            raise SystemExit(f'endereço Interlink inválido: {address}')
        if not (modules=='*' or re.fullmatch(r'[A-Z]{1,26}',modules)):
            raise SystemExit(f'módulos Interlink inválidos: {modules}')
PY
}
audit(){
  install -d -m 0770 -o root -g www-data "$STATE"
  printf '%s action=%s detail=%s backup=%s\n' "$(date -Is)" "$1" "$2" "$3" >> "$STATE/audit.log"
  chown root:www-data "$STATE/audit.log" 2>/dev/null || true
  chmod 0660 "$STATE/audit.log" 2>/dev/null || true
}

need
case "${1:-}" in
  status)
    [[ "$#" -eq 1 ]] || fail 'uso inválido'
    status
    ;;
  add-white|delete-white|add-black|delete-black)
    [[ "$#" -eq 2 ]] || fail 'uso inválido'
    lock_access
    rule="$(clean_rule "$2")" || fail 'indicativo/prefixo inválido'
    backup="$(backup_files)"
    case "$1" in
      add-white) write_rules "$WL" "$rule" add ;;
      delete-white) write_rules "$WL" "$rule" delete ;;
      add-black) write_rules "$BL" "$rule" add ;;
      delete-black) write_rules "$BL" "$rule" delete ;;
    esac
    audit "$1" "$rule" "$backup"
    status
    ;;
  save-interlink)
    [[ "$#" -eq 4 ]] || fail 'uso: save-interlink PEER ENDERECO MODULOS'
    lock_access
    peer="$(clean_peer "$2")" || fail 'peer Interlink inválido'
    address="$(clean_address "$3")" || fail 'endereço Interlink inválido'
    modules="$(clean_modules "$4")" || fail 'módulos Interlink inválidos'
    backup="$(backup_files)"
    write_interlink "$peer" "$address" "$modules" save || { cp -a "$backup/$(basename "$IL")" "$IL"; fail 'falha ao salvar Interlink; arquivo anterior restaurado'; }
    validate_interlink || { cp -a "$backup/$(basename "$IL")" "$IL"; fail 'validação do Interlink falhou; arquivo anterior restaurado'; }
    audit 'interlink-save' "$peer $address $modules" "$backup"
    status
    ;;
  delete-interlink)
    [[ "$#" -eq 2 ]] || fail 'uso: delete-interlink PEER'
    lock_access
    peer="$(clean_peer "$2")" || fail 'peer Interlink inválido'
    backup="$(backup_files)"
    write_interlink "$peer" '' '' delete || { cp -a "$backup/$(basename "$IL")" "$IL"; fail 'falha ao excluir Interlink; arquivo anterior restaurado'; }
    validate_interlink || { cp -a "$backup/$(basename "$IL")" "$IL"; fail 'validação do Interlink falhou; arquivo anterior restaurado'; }
    audit 'interlink-delete' "$peer" "$backup"
    status
    ;;
  *)
    fail 'ação não permitida'
    ;;
esac
