#!/usr/bin/env bash
set -Eeuo pipefail
export LANG=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 027

STATE="${XLX_CONTROL_STATE:-/var/lib/xlx-modern-control}"
BACKROOT="${XLX_ACCESS_BACKUPS:-/var/backups/xlx-reflector/control-access}"
WL="${XLX_WHITELIST:-/xlxd/xlxd.whitelist}"
BL="${XLX_BLACKLIST:-/xlxd/xlxd.blacklist}"
TERM="${XLX_TERMINAL:-/xlxd/xlxd.terminal}"
LOCK="${XLX_ACCESS_LOCK:-/run/lock/xlx-modern-control-access.lock}"

fail(){ printf 'ERRO: %s\n' "$*" >&2; exit 64; }
need(){
  for f in "$WL" "$BL" "$TERM"; do [[ -f "$f" ]] || fail "arquivo ausente: $f"; done
  command -v flock >/dev/null 2>&1 || fail 'flock ausente'
  command -v python3 >/dev/null 2>&1 || fail 'python3 ausente'
}
lock_access(){
  install -d -m 0755 "$(dirname "$LOCK")"
  exec 9>"$LOCK"
  flock -n 9 || fail 'outra alteração de acesso está em andamento'
}
clean_rule(){
  local x="${1^^}"
  x="${x//[[:space:]]/}"
  [[ "$x" == '*' || "$x" =~ ^[A-Z0-9]{1,8}\*?$ ]] || return 1
  if [[ "$x" == *'*'* && "$x" != '*' ]]; then
    [[ "$x" =~ ^[A-Z0-9]{1,8}\*$ ]] || return 1
  fi
  printf '%s' "$x"
}
read_rules(){ sed -E '/^[[:space:]]*($|#)/d;s/[[:space:]]//g' "$1"; }
json_string(){ python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'; }
status(){
  printf '{"whitelist":['
  local first=1 x
  while IFS= read -r x; do
    [[ -n "$x" ]] || continue
    (( first )) || printf ','
    first=0
    printf '%s' "$(printf '%s' "$x" | json_string)"
  done < <(read_rules "$WL")
  printf '],"blacklist":['
  first=1
  while IFS= read -r x; do
    [[ -n "$x" ]] || continue
    (( first )) || printf ','
    first=0
    printf '%s' "$(printf '%s' "$x" | json_string)"
  done < <(read_rules "$BL")
  local address modules
  address="$(awk '$1=="address"{print $2;exit}' "$TERM" 2>/dev/null || true)"
  modules="$(awk '$1=="modules"{print $2;exit}' "$TERM" 2>/dev/null || true)"
  [[ -n "$modules" ]] || modules='*'
  printf '],"terminal":{"address":%s,"modules":%s}}\n' \
    "$(printf '%s' "$address" | json_string)" \
    "$(printf '%s' "$modules" | json_string)"
}
backup_files(){
  local stamp dir
  stamp="$(date -u +%Y%m%d_%H%M%S)"
  dir="$BACKROOT/$stamp"
  install -d -m 0700 "$dir"
  cp -a "$WL" "$BL" "$TERM" "$dir/"
  sha256sum "$dir/$(basename "$WL")" "$dir/$(basename "$BL")" "$dir/$(basename "$TERM")" > "$dir/SHA256_BEFORE.txt"
  printf '%s' "$dir"
}
write_rules(){
  local file="$1" rule="$2" op="$3" tmp
  tmp="$(mktemp "${file}.new.XXXXXX")"
  {
    grep -E '^[[:space:]]*#|^[[:space:]]*$' "$file" || true
    if [[ "$op" == add ]]; then
      read_rules "$file"
      printf '%s\n' "$rule"
    else
      while IFS= read -r x; do [[ "$x" != "$rule" ]] && printf '%s\n' "$x"; done < <(read_rules "$file")
    fi
  } | awk '!seen[$0]++' > "$tmp"
  chown --reference="$file" "$tmp" 2>/dev/null || chown www-data:www-data "$tmp"
  chmod --reference="$file" "$tmp" 2>/dev/null || chmod 0644 "$tmp"
  mv -f "$tmp" "$file"
}
valid_address(){
  local a="$1"
  [[ -z "$a" ]] && return 0
  [[ "$a" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && return 0
  [[ "$a" =~ ^[0-9A-Fa-f:]+$ ]] && return 0
  [[ "$a" =~ ^[A-Za-z0-9.-]{1,253}$ ]] && return 0
  return 1
}
save_terminal(){
  local address="$1" modules="${2^^}" tmp
  valid_address "$address" || fail 'endereço terminal inválido'
  [[ "$modules" == '*' || "$modules" =~ ^[A-Z]{1,26}$ ]] || fail 'módulos inválidos'
  tmp="$(mktemp "${TERM}.new.XXXXXX")"
  {
    grep -E '^[[:space:]]*#|^[[:space:]]*$' "$TERM" || true
    [[ -z "$address" ]] || printf 'address %s\n' "$address"
    printf 'modules %s\n' "$modules"
  } > "$tmp"
  chown --reference="$TERM" "$tmp" 2>/dev/null || chown www-data:www-data "$tmp"
  chmod --reference="$TERM" "$tmp" 2>/dev/null || chmod 0644 "$tmp"
  mv -f "$tmp" "$TERM"
}
audit(){
  install -d -m 0770 -o root -g www-data "$STATE"
  printf '%s action=%s detail=%s backup=%s\n' "$(date -Is)" "$1" "$2" "$3" >> "$STATE/audit.log"
  chown root:www-data "$STATE/audit.log" 2>/dev/null || true
  chmod 0660 "$STATE/audit.log" 2>/dev/null || true
}

need
case "${1:-}" in
  status)
    [[ "$#" -eq 1 ]] || fail 'uso inválido'
    status
    ;;
  add-white|delete-white|add-black|delete-black)
    [[ "$#" -eq 2 ]] || fail 'uso inválido'
    lock_access
    rule="$(clean_rule "$2")" || fail 'indicativo/prefixo inválido'
    backup="$(backup_files)"
    case "$1" in
      add-white) write_rules "$WL" "$rule" add ;;
      delete-white) write_rules "$WL" "$rule" delete ;;
      add-black) write_rules "$BL" "$rule" add ;;
      delete-black) write_rules "$BL" "$rule" delete ;;
    esac
    audit "$1" "$rule" "$backup"
    status
    ;;
  save-terminal)
    [[ "$#" -eq 3 ]] || fail 'uso inválido'
    lock_access
    backup="$(backup_files)"
    save_terminal "$2" "$3"
    audit 'save-terminal' "address=$2 modules=${3^^}" "$backup"
    status
    ;;
  *)
    fail 'ação não permitida'
    ;;
esac
