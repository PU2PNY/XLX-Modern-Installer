#!/usr/bin/env bash
set -Eeuo pipefail
export LANG=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin

CORE_HELPER="/usr/local/sbin/xlx026-control-helper-core-v110"
RADIO_HELPER="/usr/local/sbin/xlx026-radioid-helper-v111"
ACCESS_HELPER="/usr/local/sbin/xlx026-access-helper-v1"
HEALTH_SNAPSHOT="/var/lib/xlx026-health-monitor/operational.json"

[[ -x "$CORE_HELPER" ]] || { echo 'ERRO: helper principal indisponível' >&2; exit 70; }
[[ -x "$RADIO_HELPER" ]] || { echo 'ERRO: helper RadioID indisponível' >&2; exit 71; }
[[ -x "$ACCESS_HELPER" ]] || { echo 'ERRO: helper de acesso indisponível' >&2; exit 72; }

case "${1:-}" in
  health-status)
    [[ "$#" -eq 1 ]] || exit 64
    [[ -r "$HEALTH_SNAPSHOT" ]] || { echo '{"ok":false,"error":"snapshot_unavailable"}'; exit 69; }
    exec /usr/bin/cat "$HEALTH_SNAPSHOT"
    ;;
  status|listeners|logs|backups|restart)
    [[ "$#" -eq 1 ]] || exit 64
    exec "$CORE_HELPER" "$1"
    ;;
  access-status)
    [[ "$#" -eq 1 ]] || exit 64
    exec "$ACCESS_HELPER" status
    ;;
  access-add-white|access-delete-white|access-add-black|access-delete-black)
    [[ "$#" -eq 2 ]] || exit 64
    exec "$ACCESS_HELPER" "${1#access-}" "$2"
    ;;
  access-interlink-add)
    [[ "$#" -eq 4 ]] || exit 64
    exec "$ACCESS_HELPER" interlink-add "$2" "$3" "$4"
    ;;
  access-interlink-delete)
    [[ "$#" -eq 2 ]] || exit 64
    exec "$ACCESS_HELPER" interlink-delete "$2"
    ;;
  radioid-status|radioid-check|radioid-refresh)
    [[ "$#" -eq 1 ]] || exit 64
    exec "$RADIO_HELPER" "$1"
    ;;
  radioid-search)
    [[ "$#" -eq 3 ]] || exit 64
    exec "$RADIO_HELPER" "$@"
    ;;
  radioid-save)
    [[ "$#" -eq 10 ]] || exit 64
    exec "$RADIO_HELPER" "$@"
    ;;
  radioid-profile-save)
    [[ "$#" -eq 3 && "$2" =~ ^[0-9]{7}$ && "$3" =~ ^[A-Z0-9]{3,8}$ ]] || exit 64
    exec /usr/bin/python3 /opt/xlx-dmr-meta-monitor/radioid_profiles.py --lookup "$2" "$3"
    ;;
  radioid-delete)
    [[ "$#" -eq 3 ]] || exit 64
    exec "$RADIO_HELPER" "$@"
    ;;
  *)
    echo 'ERRO: ação não permitida' >&2
    exit 64
    ;;
esac