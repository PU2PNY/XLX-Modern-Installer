+////////////////////////////////////////////////////////////////////////////////////////
+// AMBE gain adjustment
+//
+// Adjusts the gain (b2 parameter) in an AMBE+2 frame by the specified dB offset.
+// The AMBE+2 frame is 9 bytes (72 bits) in DMR format.
+// The b2 parameter is 5 bits: 4 bits from dat_a (bits 0-3) and 1 bit from dat_b (bit 11).
+//
+// Thread Safety: This function is thread-safe. It only reads from const global tables
+// (DMR_A_TABLE, DMR_B_TABLE, PRNG_TABLE, AMBE_GAIN_TABLE) and modifies the caller's
+// buffer. Multiple threads can safely call this function concurrently with different
+// AMBE frame buffers.
+//
+// Parameters:
+//   ambe    - pointer to 9-byte AMBE+2 frame (modified in place)
+//   db_adj  - gain adjustment in dB (positive = louder, negative = quieter)
+
+void CYsfUtils::AdjustAmbeGain(uint8 *ambe, float db_adj)
+{
+    // Input validation and early exit for no-op
+    if (ambe == NULL || db_adj == 0.0f) {
+        return;
+    }
+
+    // Extract 'a' (24 bits) from AMBE frame - needed to get dat_a and b2
+    unsigned int a = 0U;
+    unsigned int MASK = 0x800000U;
+    for (unsigned int i = 0U; i < 24U; i++, MASK >>= 1) {
+        unsigned int aPos = DMR_A_TABLE[i];
+        if (READ_BIT(ambe, aPos))
+            a |= MASK;
+    }
+
+    // Extract dat_a (12 bits) from top bits of block A (Golay systematic code)
+    unsigned int dat_a = a >> 12;
+
+    // Extract just bit 12 of block C for b2 LSB (avoid full extraction until needed)
+    unsigned int cPos12 = DMR_C_TABLE[12];
+    unsigned int c_bit12 = READ_BIT(ambe, cPos12) ? 1U : 0U;
+
+    // Extract current b2 (5 bits): bits 4-1 from dat_a[3:0], bit 0 from c[12]
+    unsigned int b2 = ((dat_a & 0x00FU) << 1) | c_bit12;
+
+    // Use precomputed lookup table for known gain values, else compute
+    unsigned int new_b2;
+    if (db_adj == 1.0f) {
+        new_b2 = B2_MAP_PLUS_1_0_DB[b2];
+    } else if (db_adj == -0.3f) {
+        new_b2 = B2_MAP_MINUS_0_3_DB[b2];
+    } else if (db_adj == -0.2f) {
+        new_b2 = B2_MAP_MINUS_0_2_DB[b2];
+    } else {
+        // Fallback: compute for uncommon gain values
+        float target_db = AMBE_GAIN_TABLE[b2] + db_adj;
+        // Clamp to table range
+        if (target_db < -2.0f) target_db = -2.0f;
+        if (target_db > 6.87f) target_db = 6.87f;
+        // Linear search for closest entry
+        new_b2 = 0U;
+        float min_diff = 100.0f;
+        for (unsigned int i = 0U; i < 32U; i++) {
+            float diff = (target_db > AMBE_GAIN_TABLE[i]) ?
+                         (target_db - AMBE_GAIN_TABLE[i]) :
+                         (AMBE_GAIN_TABLE[i] - target_db);
+            if (diff < min_diff) {
+                min_diff = diff;
+                new_b2 = i;
+            }
+        }
+    }
+
+    // Early exit if gain adjustment doesn't change the b2 index
+    if (new_b2 == b2) {
+        return;
+    }
+
+    // Now we need to modify the frame - extract remaining data
+    // Extract 'b' (23 bits) for PRNG re-scrambling
+    unsigned int b = 0U;
+    MASK = 0x400000U;
+    for (unsigned int i = 0U; i < 23U; i++, MASK >>= 1) {
+        unsigned int bPos = DMR_B_TABLE[i];
+        if (READ_BIT(ambe, bPos))
+            b |= MASK;
+    }
+
+    // Compute new dat_a with updated b2 bits
+    unsigned int new_dat_a = (dat_a & 0xFF0U) | ((new_b2 >> 1) & 0x00FU);
+
+    // Re-encode block A with Golay
+    unsigned int new_a = CGolay24128::encode24128(new_dat_a);
+
+    // Re-scramble block B: descramble with old PRNG key, re-scramble with new
+    unsigned int old_prng = PRNG_TABLE[dat_a] >> 1;
+    unsigned int new_prng = PRNG_TABLE[new_dat_a] >> 1;
+    unsigned int new_b = b ^ old_prng ^ new_prng;
+
+    // Write new 'a' back to AMBE frame
+    MASK = 0x800000U;
+    for (unsigned int i = 0U; i < 24U; i++, MASK >>= 1) {
+        unsigned int aPos = DMR_A_TABLE[i];
+        WRITE_BIT(ambe, aPos, new_a & MASK);
+    }
+
+    // Write new 'b' back to AMBE frame
+    MASK = 0x400000U;
+    for (unsigned int i = 0U; i < 23U; i++, MASK >>= 1) {
+        unsigned int bPos = DMR_B_TABLE[i];
+        WRITE_BIT(ambe, bPos, new_b & MASK);
+    }
+
+    // Write only the changed bit in block C (bit 12 = b2 LSB)
+    unsigned int new_c_bit12 = new_b2 & 0x001U;
+    WRITE_BIT(ambe, cPos12, new_c_bit12);
+}
